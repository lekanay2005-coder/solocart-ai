# --- AI (all optional) -------------------------------------------------------
# The fallback chain tries providers in this order. Every key variable accepts
# several comma-separated keys; a bad key, a quota error or an outage falls
# through to the next, then to rules and the local parser. Keys never reach
# the browser — /api/config reports liveness only.
AI_PROVIDER_ORDER=openai,gemini,openrouter,groq

OPENAI_API_KEY=
# A real, current model name. If a provider rejects it, SoloCart falls back.
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server time zone used for "today" / "this week" in totals and summaries.
APP_TZ=UTC

# --- PayPal Sandbox (optional, NEVER live) ------------------------------------
# The Sandbox host is hard-wired in server/paypal.mjs and cannot be changed.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the Sandbox app's Webhooks page. Required for /paypal/webhook signature
# verification; without it the webhook endpoint answers 503 and capture still
# completes via the return URL.
PAYPAL_WEBHOOK_ID=

# --- Offline payments (phase 3) ----------------------------------------------
# How long a buyer has to hand over a signed confirmation after the seller
# issues a request. Default 60 minutes.
OFFLINE_REQUEST_TTL_MINUTES=60

# --- Automations (phase 4) ----------------------------------------------------
# Keys MCP connections and recipe webhook tokens are encrypted with (AES-GCM).
# Without it, connections and secret links are refused instead of stored in
# plaintext. Changing it makes every stored secret unreadable — by design.
APP_VAULT_KEY=

# --- Server -------------------------------------------------------------------
# Public origin used for PayPal return and cancel URLs when deployed.
APP_BASE_URL=http://localhost:4173
PORT=4173
# Bind address. Keep 127.0.0.1 locally; use 0.0.0.0 only behind a proxy or for
# a shared preview.
HOST=127.0.0.1
# Database file. Leave empty for the default data/solocart.db; set to :memory:
# for a throwaway run with no persistence (the test suite does this itself).
SOLOCART_DB=
