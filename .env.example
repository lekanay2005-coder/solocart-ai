# Optional OpenAI Responses API connection. Without this, SoloCart uses its local demo parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional PayPal Sandbox connection. Never use live credentials in this prototype.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Public origin used for PayPal return and cancel URLs when deployed.
APP_BASE_URL=http://localhost:4173
PORT=4173
